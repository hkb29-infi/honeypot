		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/node": "^22.0.0",
		"@vitejs/plugin-react": "^6.1.2",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.2",
		"oxlint": "^1.90.0",
		"vite": "^8.3.6",
		"wrangler": "^4.161.0"
	}
}
